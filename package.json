{
  "name": "mystackovernews-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A framework-free static newspaper demo built with Node.js and Tailwind CSS CLI.",
  "scripts": {
    "build": "node build.js && tailwindcss -i ./src/input.css -o ./dist/style.css --minify",
    "dev": "npm run build && http-server ./dist -p 4173 -c-1",
    "watch": "node watch.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.17"
  }
}
